{
    "name": "liberusoftware/ecommerce-invoices-and-documents-livewire",
    "description": "The shopper's side of Invoices and Documents: a list of the documents issued to one person and a document rendered from what it froze, carrying its own number, its own currency and nothing read back out of the catalogue.",
    "type": "liberu-module",
    "license": "MIT",
    "version": "0.1.0",
    "keywords": ["laravel", "livewire", "ecommerce", "invoicing", "documents", "liberu"],
    "require": {
        "php": "^8.5",
        "illuminate/contracts": "^13.0",
        "illuminate/database": "^13.0",
        "illuminate/support": "^13.0",
        "liberusoftware/ecommerce-invoices-and-documents": "^0.1",
        "livewire/livewire": "^4.2",
        "nesbot/carbon": "^3.8.4"
    },
    "require-dev": {
        "liberusoftware/package-testbench": "^1.7",
        "pestphp/pest": "^5.0"
    },
    "autoload": {
        "psr-4": {
            "Liberu\\Ecommerce\\InvoicesAndDocuments\\Livewire\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Liberu\\Ecommerce\\InvoicesAndDocuments\\Livewire\\Tests\\": "tests/"
        }
    },
    "repositories": [
        {
            "type": "vcs",
            "url": "https://github.com/liberusoftware/module-ecommerce-invoices-and-documents"
        }
    ],
    "extra": {
        "liberu": {
            "name": "ecommerce-invoices-and-documents-livewire"
        }
    },
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true
        },
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
